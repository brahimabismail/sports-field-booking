<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/login_background"
        android:scaleType="centerCrop"
        android:contentDescription="Stadium Background" />

    <!-- Dark Overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="25dp">

            <!-- Logo -->
            <ImageView
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:src="@drawable/logo_power_league"
                android:scaleType="fitCenter"
                android:contentDescription="Power League" />

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Forgot Password?"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginTop="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter your email and we'll send you a link to reset your password."
                android:textSize="14sp"
                android:textColor="#DDFFFFFF"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp" />

            <!-- Email -->
            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Email Address"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:imeOptions="actionSend"
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#DDFFFFFF"
                android:backgroundTint="#FFFFFF" />

            <!-- Feedback message (success / error) -->
            <TextView
                android:id="@+id/tvMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginTop="15dp" />

            <!-- Loading indicator -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:indeterminate="true"
                android:visibility="gone"
                android:layout_marginTop="15dp" />

            <!-- Send Button -->
            <Button
                android:id="@+id/btnSendReset"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="SEND RESET LINK"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#176B45"
                android:layout_marginTop="25dp" />

            <!-- Back to Login -->
            <TextView
                android:id="@+id/tvBackToLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Back to Login"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:padding="12dp"
                android:layout_marginTop="12dp" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>